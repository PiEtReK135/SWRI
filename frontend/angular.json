{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "cache": { "enabled": false }
  },
  "projects": {
    "xyz": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "outputPath": { "base": "dist", "browser": "" },
            "assets": [{ "glob": "**/*", "input": "public" }],
            "styles": ["src/styles.css"],
            "optimization": true,
            "outputHashing": "all"
          },
          "configurations": {
            "development": {
              "optimization": false,
              "sourceMap": true,
              "outputHashing": "none"
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "buildTarget": "xyz:build:development" }
        }
      }
    }
  }
}
